      "typeVersion": 2.1,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "options": {}
      },
      "id": "chat-model",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [-160, 240]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Observe one public job posting and return the Job Availability service outcome. Use only when the user explicitly requests an observation.",
