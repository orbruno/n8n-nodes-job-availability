        "expectedTitle": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('expected_title', `Expected title of the job posting`, 'string') }}",
        "expectedCompany": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('expected_company', `Expected company name, or an empty string when unknown`, 'string') }}",
        "idempotencyKey": "={{$execution.id + ':ai-tool-observe'}}"
      },
      "id": "observe-posting-tool",
      "name": "Observe Public Posting",
      "type": "n8n-nodes-job-availability.jobAvailabilityTool",
      "typeVersion": 1,
      "position": [160, 240]
    }
  ],
  "connections": {
