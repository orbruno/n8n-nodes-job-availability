      "typeVersion": 1.1,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Use the Job Availability tool only when the user explicitly asks to observe a public job posting. Report the service outcome without treating an inconclusive observation as closed."
        }
      },
      "id": "ai-agent",
      "name": "AI Agent",
