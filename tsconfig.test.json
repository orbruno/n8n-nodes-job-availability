{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": false,
		"incremental": false,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["vite/client", "vitest/globals"]
	},
	"include": [
		"credentials/**/*.ts",
		"nodes/**/*.ts",
		"test/**/*.ts",
		"examples/**/*.json",
		"package.json"
	]
}
